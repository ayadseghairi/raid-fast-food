{
  "name": "raid-fast-food",
  "version": "1.2.6",
  "description": "فاست فود رائد – POS desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --no-sandbox\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist:win": "vite build && electron-builder --win",
    "lint": "eslint . --ext .js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,css}\"",
    "test": "vitest run",
    "check:version": "node scripts/check-version.js",
    "release:patch": "npm version patch -m 'release: v%s'",
    "release:minor": "npm version minor -m 'release: v%s'",
    "release:major": "npm version major -m 'release: v%s'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@fontsource/tajawal": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.raidfastfood.pos",
    "productName": "فاست فود رائد",
    "copyright": "فاست فود رائد",
    "compression": "maximum",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/**/README*",
      "!node_modules/**/*.md",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "RaidFastFood-Setup-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "فاست فود رائد",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1025",
      "artifactName": "RaidFastFood-Setup-${version}.exe"
    }
  }
}
